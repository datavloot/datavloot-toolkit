# deploy/valk/.env.example -- every variable the Valk stack reads, without values.
# Rendered by `datavloot valk render`; the real file is deploy/valk/.env (git-ignored).

COMPOSE_PROJECT_NAME=local
ZITADEL_MASTERKEY=            # 32 characters
OIDC_COOKIE_SECRET=           # 32 characters
OIDC_CLIENT_ID=               # from the Zitadel application
OIDC_CLIENT_SECRET=           # from the Zitadel application
ACME_EMAIL=                   # Let's Encrypt contact, --prod only
ZITADEL_ADMIN_PASSWORD=       # first-boot admin; upper+lower+digit+symbol
POSTGRES_PASSWORD=postgres    # hardcoded in SRDP's compose at @@srdp_ref
DAGSTER_PG_PASSWORD=dagster_pw
DATAVLOOT_S3_KEY_ID=          # storage.kind: s3 only
DATAVLOOT_S3_SECRET=
CROWSNEST_OIDC_INSECURE_TLS=@@insecure_tls
