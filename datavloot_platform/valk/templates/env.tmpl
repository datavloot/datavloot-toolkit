# deploy/valk/.env -- secrets and per-deployment values for the Valk stack.
#
# Generated ONCE by `datavloot valk render`; never overwritten, never committed
# (.gitignore has it). Delete it to regenerate the random values below.
#
# Names are SRDP's own (deploy/docker/.env.example) plus the datavloot ones the
# overlay adds. Anything empty here must be filled in before `datavloot valk up`
# does something useful.

# --- SRDP ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=local
ZITADEL_MASTERKEY=@@zitadel_masterkey
OIDC_COOKIE_SECRET=@@oidc_cookie_secret

# Paste these after creating the OIDC application in Zitadel (see README.md).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Let's Encrypt contact for --prod. Empty means local mkcert certificates.
ACME_EMAIL=@@acme_email

# --- Datavloot ----------------------------------------------------------------
# First-boot Zitadel admin password (login: zitadel-admin@zitadel.auth.@@domain).
# Zitadel wants upper, lower, digit and symbol.
ZITADEL_ADMIN_PASSWORD=@@zitadel_admin_password

# SRDP's compose hardcodes these two on the Postgres side at the pinned commit,
# so changing them here alone does nothing yet. Kept as variables so a later SRDP
# pin that reads them (PR #51 does) works without re-rendering.
POSTGRES_PASSWORD=postgres
DAGSTER_PG_PASSWORD=dagster_pw

# Object storage key pair; only used when datavloot.yml has storage.kind: s3.
DATAVLOOT_S3_KEY_ID=
DATAVLOOT_S3_SECRET=

# The Crows Nest must trust Zitadel's certificate to validate tokens. mkcert
# certificates are not in the container's trust store; Let's Encrypt is.
CROWSNEST_OIDC_INSECURE_TLS=@@insecure_tls
