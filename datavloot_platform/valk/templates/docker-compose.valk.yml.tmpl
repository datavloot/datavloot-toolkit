# deploy/valk/docker-compose.valk.yml
#
# Rendered by `datavloot valk render` from datavloot.yml, against SRDP @@srdp_ref.
# Do not edit this file; edit datavloot.yml and re-render.
#
# This is an OVERLAY on SRDP's deploy/docker/docker-compose.yml. Service names,
# network names and Traefik label keys below must match that file at the pinned
# commit. Three kinds of change are made:
#
#   1. domain      SRDP's compose hardcodes its own dev domain; every host, cookie domain
#                  and issuer URL is re-pointed at @@domain.
#   2. our images  dagster-code runs THIS project (built from deploy/valk/Dockerfile);
#                  dagster-webserver/daemon are rebuilt on the same Dagster version
#                  the project pins, so gRPC between them is never a version skew.
#   3. crowsnest   added as a service behind the same SSO gate as marimo and dagster.

x-datavloot-env: &datavloot-env
  DATAVLOOT_VESSEL: valk
  DUCKLAKE_PG_HOST: postgres
  DUCKLAKE_PG_PORT: "5432"
  DUCKLAKE_PG_DB: ducklake
  DUCKLAKE_PG_USER: postgres
  DUCKLAKE_PG_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
  DUCKLAKE_DATA_PATH: "@@data_path"
  DUCKLAKE_METADATA_SCHEMA: "@@metadata_schema"
  DATAVLOOT_S3_KEY_ID: ${DATAVLOOT_S3_KEY_ID:-}
  DATAVLOOT_S3_SECRET: ${DATAVLOOT_S3_SECRET:-}
  DATAVLOOT_S3_ENDPOINT: "@@s3_endpoint"
  DATAVLOOT_S3_REGION: "@@s3_region"
  DBT_TARGET: valk
  DBT_PROFILES_DIR: /app
  DATAVLOOT_DBT_DATABASE: "@@catalog_alias"
  DAGSTER_HOME: /opt/dagster/dagster_home
  DAGSTER_PG_HOST: postgres
  DAGSTER_PG_USER: dagster
  DAGSTER_PG_PASSWORD: ${DAGSTER_PG_PASSWORD:-dagster_pw}
  DAGSTER_PG_DB: dagster

services:
  # ---------------------------------------------
  # Domain: SRDP hardcodes a dev domain, we don't
  # ---------------------------------------------
  traefik:
    networks:
      app:
        aliases:
          - auth.@@domain
    volumes:
      - "@@valk_dir/traefik.yml:/etc/traefik/traefik.yaml:ro"

  zitadel-init:
    environment:
      ZITADEL_EXTERNALDOMAIN: auth.@@domain
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD: ${ZITADEL_ADMIN_PASSWORD:-}

  zitadel:
    environment:
      ZITADEL_EXTERNALDOMAIN: auth.@@domain
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD: ${ZITADEL_ADMIN_PASSWORD:-}

  zitadel-login:
    environment:
      - CUSTOM_REQUEST_HEADERS=Host:auth.@@domain

  oauth2-proxy:
    # Full copy of SRDP's command with the domain substituted and one scope added
    # so Zitadel asserts project roles in the token (the Crows Nest reads them).
    command:
      - --upstream=file:///dev/null
      - --provider=oidc
      - --http-address=0.0.0.0:4180
      - --email-domain=*
      - --reverse-proxy=true
      - --pass-host-header=true
      - --proxy-prefix=/oauth2
      - --whitelist-domain=.@@domain
      - --set-xauthrequest=true
      - --provider-display-name=ZITADEL
      - --oidc-issuer-url=https://auth.@@domain
      - --insecure-oidc-skip-issuer-verification=true
      - --ssl-insecure-skip-verify
      - --skip-provider-button
      - --cookie-name=_oauth2_proxy
      - --cookie-domain=.@@domain
      - --cookie-secure=true
      - --cookie-samesite=lax
      - --pass-authorization-header=false
      - --pass-access-token=true
      - --scope=openid email profile urn:zitadel:iam:org:projects:roles
    labels:
      - "traefik.http.routers.oauth2-proxy.rule=(@@hosts_rule) && PathPrefix(`/oauth2/`)"
      # SRDP forwards only User and Email to the backends. The Crows Nest validates
      # the access token itself (never the headers), so it must be forwarded too.
      - "traefik.http.middlewares.zitadel-auth.forwardauth.authResponseHeaders=X-Auth-Request-User, X-Auth-Request-Email, X-Auth-Request-Access-Token"

  # ---------------------------------------------
  # Dagster: same version as the project, our code location
  # ---------------------------------------------
  dagster-webserver:
    build:
      context: "@@valk_dir"
      dockerfile: Dockerfile.dagster
    labels:
      - "traefik.http.routers.dagster.rule=Host(`dagster.@@domain`)"

  dagster-daemon:
    build:
      context: "@@valk_dir"
      dockerfile: Dockerfile.dagster

  dagster-code:
    build:
      context: "@@project_dir"
      dockerfile: deploy/valk/Dockerfile
    environment:
      <<: *datavloot-env
      DAGSTER_CURRENT_IMAGE: srdp-dagster-code
    healthcheck:
      test: ["CMD", "dagster", "api", "grpc-health-check", "-p", "3030"]
      interval: 10s
      timeout: 5s
      start_period: 120s
      retries: 12
@@ducklake_volume_mount    networks:
      - app
      - db
    command:
      [
        "dagster", "code-server", "start",
        "-h", "0.0.0.0",
        "-p", "3030",
        "-m", "@@module_name",
      ]

  # ---------------------------------------------
  # Crows Nest: this project's dashboard, behind the same SSO gate
  # ---------------------------------------------
  crowsnest:
    build:
      context: "@@project_dir"
      dockerfile: deploy/valk/Dockerfile
    container_name: valk-crowsnest
    restart: unless-stopped
    environment:
      <<: *datavloot-env
      CROWSNEST_DAGSTER_URL: http://dagster-webserver:3000/graphql
      CROWSNEST_DAGSTER_PUBLIC_URL: https://dagster.@@domain
      CROWSNEST_MARIMO_URL: https://marimo.@@domain
      CROWSNEST_OIDC_ISSUER: https://auth.@@domain
      CROWSNEST_OIDC_DEFAULT_ROLE: "@@default_role"
      # mkcert certificates are not in the container's trust store; Let's Encrypt is.
      CROWSNEST_OIDC_INSECURE_TLS: ${CROWSNEST_OIDC_INSECURE_TLS:-@@insecure_tls}
@@ducklake_volume_mount    networks:
      - app
      - db
    depends_on:
      postgres:
        condition: service_healthy
      dagster-code:
        condition: service_healthy
    entrypoint: []
    command:
      [
        "datavloot", "launch",
        "--host", "0.0.0.0",
        "--port", "8080",
        "--no-open",
      ]
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=srdp-app"
      - "traefik.http.routers.crowsnest.rule=Host(`crowsnest.@@domain`)"
      - "traefik.http.routers.crowsnest.service=crowsnest@docker"
      - "traefik.http.services.crowsnest.loadbalancer.server.port=8080"
      - "traefik.http.routers.crowsnest.middlewares=zitadel-errors@docker,zitadel-auth@docker"

  # ---------------------------------------------
  # SRDP's own apps, re-pointed at the domain
  # ---------------------------------------------
  marimo:
    labels:
      - "traefik.http.routers.marimo.rule=Host(`marimo.@@domain`)"

  quarto:
    labels:
      - "traefik.http.routers.quarto.rule=Host(`quarto.@@domain`)"

@@ducklake_volume_def