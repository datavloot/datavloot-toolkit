# Your Spotify developer app (README.md, "Use your own Spotify data"): the
# Client ID from developer.spotify.com/dashboard. No client secret is needed.
SPOTIFY_CLIENT_ID=

# Where Spotify sends you back after logging in: must be listed under the
# developer app's Redirect URIs exactly like this. Spotify does not accept localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
