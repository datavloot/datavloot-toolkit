# Copy to .env (git-ignored) next to compose.yaml.

# Services run at dagster.<DOMAIN>, crowsnest.<DOMAIN> and marimo.<DOMAIN>;
# a wildcard DNS record *.<DOMAIN> must point at the server.
DOMAIN=falcon.example.nl

# Let's Encrypt writes here about expiring certificates.
ACME_EMAIL=you@example.nl

# The directory on the host that holds the project(s), and the project to run.
FALCON_DIR=/srv/falcon
PROJECT=noaa

# The owner of FALCON_DIR (`id -u` and `id -g` as that user): the services run
# as this uid and gid, or they cannot write the project. Rebuild after a change.
FALCON_UID=1000
FALCON_GID=1000

# 1: create the NOAA demo in FALCON_DIR/PROJECT if there is no project yet.
FALCON_DEMO=0

# Sign-in: basic (users in traefik/users.htpasswd) or oidc (single sign-on
# through the customer's identity provider; fill in the OIDC_* settings).
FALCON_AUTH=basic
# Starts oauth2-proxy for oidc. Leave it as it is.
COMPOSE_PROFILES=${FALCON_AUTH}

# FALCON_AUTH=oidc only. Register an application (a confidential OIDC client)
# at the provider with these redirect URIs:
#   https://crowsnest.<DOMAIN>/oauth2/callback
#   https://dagster.<DOMAIN>/oauth2/callback
#   https://marimo.<DOMAIN>/oauth2/callback
# Entra ID: https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
OIDC_COOKIE_SECRET=
# Shown on the sign-in page.
OIDC_PROVIDER_NAME=
# The claim that names the user. Entra ID often has no `email` claim:
# preferred_username then.
OIDC_EMAIL_CLAIM=email
# true: also let in users whose provider says their email is not verified
# (email_verified=false), which includes a user without an address. Leave it
# false unless a sign-in fails with "email in id_token ... isn't verified".
OIDC_ALLOW_UNVERIFIED_EMAIL=false
# Only members of these groups get in (comma-separated); empty lets in whoever
# the provider signs in. Entra ID puts group object IDs in `groups`, not names.
OIDC_ALLOWED_GROUPS=
