# Copy to .env (git-ignored) next to compose.yaml. Generate each secret with:
#   openssl rand -base64 24

# The Falcon's domain: Keycloak runs at idp.<DOMAIN>.
DOMAIN=falcon.example.nl

# Keycloak's admin console (https://idp.<DOMAIN>/admin), user `admin`.
KEYCLOAK_ADMIN_PASSWORD=

# The Falcon's client secret at the provider: the same value goes into the
# Falcon's .env as OIDC_CLIENT_SECRET.
FALCON_TEST_CLIENT_SECRET=

# The password of the test users alice, bob and carol.
FALCON_TEST_PASSWORD=
